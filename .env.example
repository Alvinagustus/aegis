# Copy to .env and fill in your own values — never commit the real file
# Get an API key at https://cloud.near.ai (or claim credits via https://nearbuilders.org/join)

# NEAR AI Cloud (required by tools/reviewer/ and tools/bench/)
NEAR_AI_API_KEY=sk-your-key-here
# Model used by the reviewer (optional, default Qwen/Qwen3.8-27B)
# REVIEW_MODEL=Qwen/Qwen3.8-27B

# Reviewer agent on-chain attestation (tools/reviewer/review.mjs --submit)
# WATCHDOG_CONTRACT=watchdog-v5-4d8a7f.testnet
# REVIEWER_ACCOUNT=watchdog-reviewer-4d8a7f.testnet
# REVIEWER_KEY=ed25519:your-reviewers-private-key
